# shellcheck shell=bash
# 极简版 env.sh —— 日常脚本：sync-intranet / promote / vps-watch / preflight
#
# 用法：
#   cp private/env.sh.minimal.example private/env.sh
#   $EDITOR private/env.sh
#   chmod 600 private/env.sh
#   source private/env.sh

# ─── VPS（公网 IPv4）──────────────────────────────────
export VPS_IP="x.x.x.x"                  # 当前生产 VPS；本机为 <VPS_IP>

# 单台命令默认走哪台（历史兼容字段）
# export VPS_IP="<VPS_IP>"

# 多机：sync-intranet.sh / vps-watch-urls.sh / preflight-multi-vps.sh
export VPS_IP_LIST="vultr:${VPS_IP}"
# 多机示例：
# export VPS_IP_BACKUP="y.y.y.y"
# export VPS_NODES="vultr:${VPS_IP} backup:${VPS_IP_BACKUP}"
# export VPS_IP_LIST="${VPS_NODES}"

export VPS_SSH_USER="root"
export VPS_SSH_KEY="$HOME/.ssh/id_rsa_ace_vpn"
export SUB_PORT_CLASH="25500"
export SUB_PATH_PREFIX="clash_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export SUB_ID_SELF="ace-main"
export SUB_TOKENS="ace-main,ace-fork"
export LOCAL_PROXY="http://127.0.0.1:7890"

vps-fetch-creds() {
  if [[ -n "${VPS_SSH_KEY:-}" ]]; then
    scp -i "$VPS_SSH_KEY" "$VPS_SSH_USER@$VPS_IP:/root/ace-vpn-credentials.txt" "/tmp/ace-vpn-creds-$$.txt"
  else
    scp "$VPS_SSH_USER@$VPS_IP:/root/ace-vpn-credentials.txt" "/tmp/ace-vpn-creds-$$.txt"
  fi
  chmod 600 "/tmp/ace-vpn-creds-$$.txt"
  echo "已从 ${VPS_IP} 保存到 /tmp/ace-vpn-creds-$$.txt（用完 rm）"
  # 多机时可临时覆盖：VPS_IP=<另一台IP> vps-fetch-creds
}
