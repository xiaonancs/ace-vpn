# shellcheck shell=bash
# 复制为 env.sh 后填真实值；env.sh 会被 .gitignore 排除。
# 使用：source private/env.sh

# ==== VPS 基础信息 ====
export VPS_PROVIDER="vultr-tokyo"              # 便于区分：vultr / oracle / hostdare / racknerd
# 双机时建议写清两台 IP，再导出「主线」VPS_IP（下面 URL_* 仍用 VPS_IP）：
export VPS_IP_HOSTHATCH="xxx.xxx.xxx.xxx"
export VPS_IP_VULTR="yyy.yyy.yyy.yyy"
export VPS_IP="${VPS_IP_HOSTHATCH}"           # 单台脚本 / 订阅 URL 默认指向这台
export VPS_NODES="hosthatch:${VPS_IP_HOSTHATCH} vultr:${VPS_IP_VULTR}"   # --all-vps / vps-watch
export VPS_SSH_USER="root"
export VPS_SSH_KEY="$HOME/.ssh/id_ed25519_vps"  # 可选，未用 key 登录就留空

# ==== AI 稳定性测试（可选）====
# 期望出口国家，用于识别 ip.sb / ipwho.is / ipapi.is / Cloudflare 等地理库漂移。
# 日本东京节点建议填 JP；如果不同节点国家不同，可按节点名单分别设置。
export AI_PROBE_EXPECTED_COUNTRY_HOSTHATCH="JP"
export AI_PROBE_EXPECTED_COUNTRY_VULTR="JP"

# 默认 AI 稳定性测试不发送 API Key，只测公开入口与地理库。
# 如需从每台 VPS 测真实 API Key 鉴权，可打开下面开关并填 Key。
# 如需进一步测试最小真实模型调用和 SSE 流式返回，再打开 AI_PROBE_ENABLE_REAL_CALLS。
# 注意：真实调用会消耗少量额度；脚本默认 max token/output 为 1。
# export AI_PROBE_ENABLE_KEY_TESTS=1
# export AI_PROBE_ENABLE_REAL_CALLS=1
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."
# export GEMINI_API_KEY="..."
# export AI_PROBE_OPENAI_MODEL="gpt-4o-mini"
# export AI_PROBE_ANTHROPIC_MODEL="claude-3-5-haiku-latest"
# export AI_PROBE_GEMINI_MODEL="gemini-1.5-flash"

# ==== 3x-ui 面板 ====
# 须与面板「设置」里的端口一致，且 UFW / 云防火墙已放行（改端口后别只改书签）
export PANEL_PORT="41785"                       # 示例占位；真实值以 ss -lntp | grep x-ui 为准
export PANEL_PATH="/xxxxxxxxx"                  # 随机 path（带前导 /）
export PANEL_USER="xxxxxxxx"                    # 你改过的用户名，不是 admin
export PANEL_PASS="xxxxxxxxxxxxxxxx"

# ==== 订阅服务（3x-ui 原生 + 我们的 Clash 转换器）====
export SUB_PORT_XUI="2096"                      # 3x-ui 订阅端口
export SUB_PATH_XUI="/sub_xxxxxxx"              # 订阅路径（带前导 /）
export SUB_JSON_PATH_XUI="/json_xxxxxxx"

export SUB_PORT_CLASH="25500"                   # 我们的 sub-converter 监听端口

# ==== sub-converter 多 token 模式（推荐）====
# token 必须和下面的 SUB_ID_* 保持一致，sub-converter 凭 token 去 3x-ui 拉对应 SubId 的订阅
export SUB_TOKENS="sub-hxn,sub-hxn01"           # 逗号分隔白名单，跟 3x-ui 的 SubId 一一对应

# ==== 每个 SubId（面板里一组 client）对应一条订阅 URL ====
export SUB_ID_SELF="sub-hxn"                    # 你自己所有设备挂在这个 SubId 下
export SUB_ID_FAMILY="sub-hxn01"                # 家人所有设备挂这个 SubId（以后单独吊销用）

# ==== 常用 URL（脚本里 `$URL_CLASH_SELF` 直接可用）====
export URL_XUI_SUB_SELF="https://${VPS_IP}:${SUB_PORT_XUI}${SUB_PATH_XUI}/${SUB_ID_SELF}"
export URL_CLASH_SELF="http://${VPS_IP}:${SUB_PORT_CLASH}/clash/${SUB_ID_SELF}"
export URL_CLASH_FAMILY="http://${VPS_IP}:${SUB_PORT_CLASH}/clash/${SUB_ID_FAMILY}"

# ==== 公司内网分流（legacy，保留只为兼容旧部署）====
# 新部署用 private/intranet.yaml + scripts/sync-intranet.sh，支持多 profile + 热加载
export COMPANY_CIDRS=""                         # 如 "10.128.0.0/16"
export COMPANY_SFX=""                           # 如 "corp.example.com"

# ==== 常用小工具 ====
vps-ssh()  { ssh -i "$VPS_SSH_KEY" "${VPS_SSH_USER}@${VPS_IP}" "$@"; }
vps-scp()  { scp -i "$VPS_SSH_KEY" "$@" "${VPS_SSH_USER}@${VPS_IP}:/tmp/"; }
vps-xui()  { vps-ssh -t "x-ui"; }
vps-credentials() { scp -i "$VPS_SSH_KEY" "${VPS_SSH_USER}@${VPS_IP}:/root/ace-vpn-credentials.txt" "$(dirname "$BASH_SOURCE")/credentials.txt"; chmod 600 "$(dirname "$BASH_SOURCE")/credentials.txt"; }
